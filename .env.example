# -------------------------------------------------------------
# AI Resume & Job Description Matcher Configuration
# -------------------------------------------------------------

# LLM Provider: auto | gemini | openai | heuristic
# If no key is supplied, the built-in Hybrid Heuristic Semantic Engine is used seamlessly.
LLM_PROVIDER=auto

# Google Gemini API Key (Recommended)
GEMINI_API_KEY=

# OpenAI API Key (Alternative)
OPENAI_API_KEY=

# Fallback generic API Key
LLM_API_KEY=

# LLM Model Name
LLM_MODEL=gemini-2.5-flash

# Database Configuration (SQLite default, easily swappable to PostgreSQL)
DATABASE_URL=sqlite:///./resume_matcher.db

# Application Port & Debug Mode
DEBUG=false
